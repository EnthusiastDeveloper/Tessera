#!/bin/bash
# Pre-commit hook for Tessera
# Runs the same checks as CI (see Makefile's `check` target) before allowing a commit.
# Install with: make install-hooks
# Bypass with: git commit --no-verify

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

REPO_ROOT=$(git rev-parse --show-toplevel)

echo -e "${YELLOW}Running pre-commit checks (make check)...${NC}\n"

if (cd "$REPO_ROOT" && make check); then
  echo -e "\n${GREEN}✓ All checks passed. Committing...${NC}"
  exit 0
else
  echo -e "\n${RED}✗ Some checks failed. Fix the issues above and try again.${NC}"
  echo -e "${YELLOW}To bypass: git commit --no-verify${NC}"
  exit 1
fi
